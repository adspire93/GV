# GammaVantage Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=GammaVantage
APP_VERSION=1.0.0

# WhatsApp Business API
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_verification_token_here
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Database - PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/gammavantage
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Time-Series Database - InfluxDB
TIMESERIES_DB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=gammavantage
INFLUXDB_BUCKET=market_data

# Cache - Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Market Data Provider (choose one)
MARKET_DATA_PROVIDER=truedata  # truedata, zerodha, upstox
MARKET_DATA_API_KEY=your_market_data_api_key_here
MARKET_DATA_API_URL=https://api.truedata.in/
MARKET_DATA_WEBSOCKET_URL=wss://ws.truedata.in/

# Chartink Integration
CHARTINK_WEBHOOK_SECRET=your_chartink_secret_here
CHARTINK_API_KEY=your_chartink_api_key_here

# Payment Gateway (Razorpay/Stripe)
PAYMENT_GATEWAY=razorpay  # razorpay or stripe
PAYMENT_GATEWAY_KEY=your_payment_key_here
PAYMENT_GATEWAY_SECRET=your_payment_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Cache TTL (seconds)
CACHE_TTL_LIVE_PRICE=60
CACHE_TTL_HISTORICAL=3600
CACHE_TTL_SCREENER=900
CACHE_TTL_SNAPSHOT=30

# Rate Limiting
RATE_LIMIT_PER_USER=10  # queries per minute
RATE_LIMIT_GLOBAL=1000  # queries per minute

# Subscription Plans
PLAN_FREE_TRIAL_DAYS=7
PLAN_FREE_TRIAL_QUERY_LIMIT=5
PLAN_BASIC_PRICE=499
PLAN_PRO_PRICE=999
PLAN_ELITE_PRICE=2499

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log
ERROR_LOG_FILE=data/logs/error.log

# Feature Flags
ENABLE_TRADE_SIMULATOR=True
ENABLE_SCREENERS=True
ENABLE_CUSTOM_ALERTS=False  # Pro feature
ENABLE_API_ACCESS=False  # Elite feature

# System
MAX_RESPONSE_TIME_MS=2000
MAX_WORKERS=4
